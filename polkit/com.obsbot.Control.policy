<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  SCAFFOLD polkit policy for obsbotd.

  The default allows any active local session to control the camera without
  a password — webcams belong to the user sitting at the machine, same as
  microphones and monitors. Tighten by editing this policy or shipping a
  site-specific override.
-->
<policyconfig>
  <vendor>obsbotctl</vendor>
  <vendor_url>https://github.com/aaronsb/obsbotctl</vendor_url>

  <action id="com.obsbot.Control1.control-camera">
    <description>Control an OBSBOT camera</description>
    <message>Authentication is required to control OBSBOT cameras</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

</policyconfig>
