# obsbotd — D-Bus system daemon for OBSBOT camera control
# SCAFFOLD — not yet installable

[Unit]
Description=OBSBOT camera control daemon
Documentation=https://github.com/aaronsb/obsbotctl
After=dbus.service

[Service]
Type=dbus
BusName=com.obsbot.Control1
ExecStart=/usr/bin/obsbotd
Restart=on-failure
RestartSec=5

# Sandboxing. Tighten as features land; USB access will require explicit
# DeviceAllow entries for /dev/bus/usb/*/* and the /dev/videoN nodes of
# connected OBSBOT cameras.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
# DeviceAllow=/dev/bus/usb/* rw
# DeviceAllow=char-video4linux rw

[Install]
WantedBy=multi-user.target
